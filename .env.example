# Base de données (Phase 2)
# Local : postgresql://postgres:postgres@localhost:5432/meeed_dev
# Heroku : injectée automatiquement par l'addon Heroku Postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/meeed_dev"

# Auth (Phase 4)
# Production : https://meeed.fr (ou l'URL Heroku temporaire avant bascule DNS)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
# Optionnel : active le switch rapide de comptes en dehors de `NODE_ENV=development`
ENABLE_DEV_ACCOUNT_SWITCHER="false"

# Assistant de démonstration interactive (panneau + spotlight)
# "1" = activé ; toute autre valeur / absent = désactivé (défaut production)
NEXT_PUBLIC_DEMO_TOUR="0"
# Comptes démo (seed / DevAccountSwitcher) — ne pas committer de vrais secrets
# DEMO_CONTRIBUTEUR_EMAIL=contributeur@meeed.demo
# DEMO_ADMIN_EMAIL=admin@meeed.demo

# Next.js — évite le patch lockfile SWC (fetch npm bloqué sur certains réseaux Windows)
NEXT_IGNORE_INCORRECT_LOCKFILE=1

# Cloudinary (Phase 3)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
# Optionnel : active le ping Cloudinary dans `/api/health` en local
CLOUDINARY_HEALTHCHECK_ENABLED="false"

# SMTP — notifications forum (FB-16, étape 8)
# Laisser vide en local pour désactiver l'envoi ; la publication des réponses reste OK.
# Sert aussi à l'envoi des liens "mot de passe oublié" et de confirmation de création de compte.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="MEEED Forum <noreply@meeed.fr>"
# false en local si antivirus Windows cause "self-signed certificate in certificate chain"
SMTP_TLS_REJECT_UNAUTHORIZED="false"

# Heroku (auto-injectées, ne pas définir en local)
# PORT=...
# NODE_ENV=production
